@{
    ViewData["Title"] = "Live Chat";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var token = Context.Session.GetString("Token") ?? "";
    string routeApi = ViewBag.ApiUrl;
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar: List User -->
        <div class="col-md-4 col-lg-3 border-end h-auto" style="overflow-y: auto;">
            <h5 class="mt-3">👥 Online Users</h5>
            <ul class="list-group" id="userList">
                <!-- Contoh dummy -->
                <li class="list-group-item list-group-item-action" data-userid="user1">John Doe</li>
                <li class="list-group-item list-group-item-action" data-userid="user2">Jane Smith</li>
            </ul>
        </div>

        <!-- Chat Area -->
        <div class="col-md-8 col-lg-9 d-flex flex-column" style="height: 80vh;">
            <div class="border-bottom py-2 px-3 bg-light">
                <strong id="chatWith">Chat with: <span class="text-primary">-</span></strong>
            </div>

            <div id="chatMessages" class="flex-grow-1 overflow-auto p-3" style="background-color: #f1f1f1;">
                <!-- Chat messages akan ditampilkan di sini -->
            </div>

            <div class="input-group p-3 border-top bg-white">
                <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." />
                <button class="btn btn-primary" id="sendMessageBtn">Send</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
	<script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("@routeApi/chatHub", {
                accessTokenFactory: () => "@token" // jika pakai JWT
            })
            .build();

        let currentUser = null; // user yang sedang dibuka chat-nya
        let myName = null;

        // Saat user terhubung ke SignalR
        connection.start().then(() => {
            console.log("Connected to SignalR");

            // Panggil method dari server untuk dapatkan username
            connection.invoke("GetMyUserName")
                .then(userName => {
                    console.log("My username from server:", userName);
                    myName = userName;

                    // Minta daftar online user dari server
                    connection.invoke("GetOnlineUsers");
                })
                .catch(err => console.error(err.toString()));
        });

        // Tampilkan daftar user online
        connection.on("UserConnected", (userName) => {
            addUserToList(userName);
        });

        connection.on("UserDisconnected", (userName) => {
            removeUserFromList(userName);
        });

        connection.on("OnlineUsers", (users) => {
            document.getElementById("userList").innerHTML = "";
            users.forEach(addUserToList);
        });

        function addUserToList(userName) {
            if (userName === myName) return;

            const ul = document.getElementById("userList");
            const existing = ul.querySelector(`[data-userid='${userName}']`);

            if (existing) {
                existing.classList.remove("text-muted");
                existing.classList.add("text-success");
                existing.innerHTML = `${userName} <span class="badge bg-success ms-2">Online</span>`;
                return;
            }

            const li = document.createElement("li");
            li.className = "list-group-item list-group-item-action text-success"; // hijau untuk online
            li.innerHTML = `${userName} <span class="badge bg-success ms-2">Online</span>`;;
            li.setAttribute("data-userid", userName);
            li.addEventListener("click", () => selectUser(userName));
            ul.appendChild(li);
        }

        function removeUserFromList(userName) {
            const li = document.querySelector(`[data-userid='${userName}']`);
            if (li) {
                li.classList.remove("text-success");
                li.classList.add("text-muted");
                li.innerHTML = `${userName} <span class="badge bg-secondary ms-2">Offline</span>`;
            }
        }


        function selectUser(userName) {
            currentUser = userName;
            document.querySelector("#chatWith span").textContent = userName;
            document.getElementById("chatMessages").innerHTML = "";

            // (Opsional) Fetch chat history dari API
            fetch('/Chat/GetHistory', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    userId1: userName,
                    userId2: myName
                })
            })
            .then(res => res.json())
            .then(data => {
                data.forEach(msg => {
                    renderMessage(msg.senderId, msg.message)
                });
            });

        }

        // Terima pesan
        connection.on("ReceivePrivateMessage", (fromUser, message) => {
            if (fromUser === currentUser) {
                renderMessage(fromUser, message);
            } else {
                alert(`New message from ${fromUser}`);
            }
        });

        // Kirim pesan
        document.getElementById("sendMessageBtn").addEventListener("click", () => {
            const msg = document.getElementById("messageInput").value;
            if (!msg || !currentUser) return;

            connection.invoke("SendPrivateMessage", currentUser, msg);
            renderMessage(myName, msg);
            document.getElementById("messageInput").value = "";
        });

        function renderMessage(sender, message) {
            const container = document.getElementById("chatMessages");
            const msgEl = document.createElement("div");
            msgEl.className = sender === myName ? "text-end text-primary" : "text-start text-dark";
            msgEl.innerHTML = `<div class="d-inline-block bg-white p-2 rounded shadow-sm mb-1">
                <small><strong>${sender}</strong>: ${message}</small>
            </div>`;
            container.appendChild(msgEl);
            container.scrollTop = container.scrollHeight;
        }

	</script>
}